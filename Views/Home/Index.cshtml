@{
    ViewData["Title"] = "Emergency blood coordination";
}
<section class="hero">
    <div>
        <h1>Find the right donor before the clock runs out.</h1>
        <p class="muted mt-3" style="max-width:34rem;font-size:1.1rem">
            When a hospital raises an emergency request, LifeLine checks blood group, eligibility and distance,
            then alerts the best-matched donors on screen within seconds.
        </p>
        <div class="d-flex gap-2 flex-wrap mt-4">
            <a class="btn btn-red btn-lg" asp-controller="Account" asp-action="RegisterDonor">Register as donor</a>
            <a class="btn btn-ghost btn-lg" asp-controller="Account" asp-action="RegisterHospital">Register hospital</a>
            <a class="btn btn-ghost btn-lg" asp-controller="Account" asp-action="Login">Sign in</a>
        </div>
    </div>

    <div class="panel demo-ticket" aria-label="Example of an incoming request">
        <div class="panel-h"><h3>Incoming request</h3><span class="tag t-critical">Critical</span></div>
        <div class="panel-b d-flex gap-4 align-items-center">
            <div class="grp">O+</div>
            <div>
                <strong>2 units needed</strong>
                <div class="muted">City General Hospital</div>
                <div class="muted">3.2 km from you</div>
            </div>
        </div>
        <div class="panel-b pt-0">
            <div class="bar"><i style="width:50%"></i></div>
            <div class="muted small mt-2">1 of 2 donors accepted</div>
        </div>
    </div>
</section>

<div class="stats mb-5">
    <div class="stat"><div class="n">@ViewBag.Donors</div><div class="l">Registered donors</div></div>
    <div class="stat"><div class="n">@ViewBag.Hospitals</div><div class="l">Verified hospitals</div></div>
    <div class="stat"><div class="n">@ViewBag.Fulfilled</div><div class="l">Requests fulfilled</div></div>
</div>

<h2 class="sec-title mb-3">How a request moves through the system</h2>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="step"><div class="no">1</div><h3 class="mt-2 mb-1" style="font-size:1.3rem">Hospital raises it</h3><p class="muted mb-0">Blood group, units and urgency. Only admin-verified hospitals can do this.</p></div></div>
    <div class="col-md-4"><div class="step"><div class="no">2</div><h3 class="mt-2 mb-1" style="font-size:1.3rem">The system ranks donors</h3><p class="muted mb-0">Wrong blood group, recent donors and far-away donors are removed. The rest are scored.</p></div></div>
    <div class="col-md-4"><div class="step"><div class="no">3</div><h3 class="mt-2 mb-1" style="font-size:1.3rem">Donors answer live</h3><p class="muted mb-0">The top donors get an instant alert. The hospital watches accept and decline answers arrive.</p></div></div>
</div>

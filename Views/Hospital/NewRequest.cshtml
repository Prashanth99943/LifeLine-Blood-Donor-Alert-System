@model NewRequestVm
@{
    ViewData["Title"] = "New request";
}
<h1 class="page-title mb-3">Raise an emergency request</h1>
<div class="row g-3">
    <div class="col-lg-6">
        <div class="panel">
            <div class="panel-b">
                <form asp-action="NewRequest" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BloodGroup" class="form-label"></label>
                            <select asp-for="BloodGroup" class="form-select">
                                <option value="">Select</option>
                                @foreach (var g in BloodRules.Groups) { <option value="@g">@g</option> }
                            </select>
                            <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UnitsNeeded" class="form-label"></label>
                            <input asp-for="UnitsNeeded" class="form-control" type="number" min="1" max="20" />
                            <span asp-validation-for="UnitsNeeded" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Urgency" class="form-label"></label>
                            <select asp-for="Urgency" class="form-select" asp-items="Html.GetEnumSelectList<Urgency>()"></select>
                        </div>
                        <div class="col-12">
                            <label asp-for="PatientNote" class="form-label"></label>
                            <textarea asp-for="PatientNote" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                    <button class="btn btn-red mt-4">Send alert to matched donors</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel">
            <div class="panel-h"><h3>How donors are chosen</h3></div>
            <div class="panel-b">
                <ol class="mb-3 ps-3">
                    <li>Remove donors with an incompatible blood group, alerts switched off, or a donation in the last @BloodRules.GapDays days.</li>
                    <li>Remove donors outside the search radius for this urgency.</li>
                    <li>Score the rest: exact group 50 or compatible 30, plus up to 40 for being close, plus 10 if well rested.</li>
                    <li>Alert the highest scores first.</li>
                </ol>
                <table class="tbl">
                    <thead><tr><th>Urgency</th><th>Search radius</th><th>Donors alerted</th><th>Request expires</th></tr></thead>
                    <tbody>
                    @foreach (var u in Enum.GetValues<Urgency>())
                    {
                        var p = MatchingService.Policy(u);
                        <tr><td><span class="tag t-@Fmt.Cls(u)">@u</span></td><td>@p.Radius km</td><td>Top @p.Top</td><td>@p.ExpiryHours h</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@model List<BloodRequest>
@{
    ViewData["Title"] = "My requests";
}
<div class="d-flex justify-content-between align-items-end mb-3">
    <h1 class="page-title">My requests</h1>
    <a class="btn btn-red" asp-action="NewRequest">Raise emergency request</a>
</div>
<div class="panel"><div class="scroll-x">
    <table class="tbl">
        <thead><tr><th>Raised</th><th>Blood</th><th>Units</th><th>Urgency</th><th>Alerted</th><th>Accepted</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.CreatedAt.ToString("dd MMM HH:mm")</td>
                <td><strong>@b.BloodGroup</strong></td>
                <td>@b.UnitsNeeded</td>
                <td><span class="tag t-@Fmt.Cls(b.Urgency)">@b.Urgency</span></td>
                <td>@b.Responses.Count</td>
                <td>@b.AcceptedCount</td>
                <td><span class="tag t-@Fmt.Cls(b.Status)">@b.Status</span></td>
                <td><a asp-action="Details" asp-route-id="@b.Id">Open</a></td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="8" class="muted">You have not raised any request yet.</td></tr>
        }
        </tbody>
    </table>
</div></div>
